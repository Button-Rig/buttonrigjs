{
  "name": "buttonrig",
  "version": "2.2.0",
  "description": "API for your plugin to work with the Button Rig App.",
  "type": "module",
  "main": "dist/main.js",
  "types": "dist/main.d.ts",
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc",
    "prepare": "npm run build",
    "test": "npm run build && node --test test/*.test.mjs",
    "sync-theme": "bash scripts/sync-theme.sh",
    "publish": "npx tsc && npm publish"
  },
  "author": "Button Rig",
  "license": "Apache 2.0",
  "devDependencies": {
    "@types/node": "^24.9.1",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "uuid": "^13.0.0"
  },
  "files": [
    "dist",
    "src",
    "theme.css",
    "fonts"
  ]
}
